---
layout: base.njk
---
<h1>{{ title }}</h1>
{{ content | safe }}
<ul class="pub-list">
{%- for pub in publikationen %}
  <li class="pub">
    {% if pub.cover %}<img class="pub-cover" src="{{ pub.cover }}" alt="Buchcover: {{ pub.titel }}" loading="lazy">
    {% else %}<span class="pub-cover pub-cover-placeholder" aria-hidden="true"></span>{% endif %}
    <div class="pub-text">
      <p class="pub-title">{{ pub.titel }}</p>
      {% if pub.untertitel %}<p class="pub-subtitle">{{ pub.untertitel }}</p>{% endif %}
      <p class="pub-meta">{{ pub.verlag }}, {{ pub.jahr }}{% if pub.rolle %} ({{ pub.rolle }}){% endif %}</p>
    </div>
  </li>
{%- endfor %}
</ul>
